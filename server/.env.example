# Bind this Node process only to localhost when Caddy/Nginx terminates HTTPS.
HOST=127.0.0.1
PORT=8787

# Agent identity expected during the WebSocket registration.
TUNNEL_AGENT_ID=jetbrains-pc

# Generate two distinct random secrets. Never commit the real .env file.
CLIENT_BEARER_TOKEN=replace-with-a-long-random-token
AGENT_BEARER_TOKEN=replace-with-a-different-long-random-token

# Limits and timeouts.
MAX_REQUEST_BYTES=10485760
REQUEST_TIMEOUT_MS=120000
