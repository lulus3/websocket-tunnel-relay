# Public HTTPS origin of the VPS. The agent changes it to WSS automatically.
RELAY_URL=https://mcp.example.com
AGENT_ID=jetbrains-pc
AGENT_BEARER_TOKEN=replace-with-the-agent-token-from-server-env

# Named services this agent may reach. The agent rejects names not listed here.
# A service can point to a loopback service or a private network address.
SERVICES_JSON='{"service-name":"http://127.0.0.1:3000"}'

RECONNECT_MAX_MS=30000
